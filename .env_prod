# ===== APPLICATION =====
IMAGE_NAME=brice99/gesafriknotification:prod
APP_NAME=gesafrikNotification-prod
CONTAINER_NAME=gesafrikNotification-prod
EXTERNAL_PORT=8089
CONTAINER_PORT=8089
CONTEXT_PATH=/api/notification

# ===== DISCOVERY =====
EUREKA_URL=http://discovery-service:8761/eureka

# ===== KAFKA =====
KAFKA_BOOTSTRAP_SERVERS=kafka:9093

# ===== MAIL =====
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
