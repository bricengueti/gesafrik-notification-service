# ===== APPLICATION =====
IMAGE_NAME=brice99/gesafriknotificationservice:dev
APP_NAME=gesafriknotificationservice-dev
CONTAINER_NAME=gesafriknotificationservice-dev
EXTERNAL_PORT=8088
CONTAINER_PORT=8088
CONTEXT_PATH=/api/notification

# ===== DISCOVERY =====
EUREKA_URL=http://discovery-service:8761/eureka

# ===== KAFKA =====
KAFKA_BOOTSTRAP_SERVERS=kafka:9093

# ===== MAIL =====
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
